# ============================================================
# QMS Griffo — Variables de entorno
# Copiar a .env.local y completar con valores reales
# ============================================================

# -----------------------------------------------------------
# Supabase — REQUERIDO
# Obtener desde: Supabase Dashboard > Settings > API
# -----------------------------------------------------------

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key (pública, segura para el browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (NUNCA exponer al cliente, solo servidor/Edge Functions)
# Usada por Edge Functions (notificaciones, cron)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------
# Resend — Para notificaciones por email (Fase 2)
# Obtener desde: resend.com > API Keys
# -----------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email desde el cual se envían las notificaciones
# Debe estar verificado en Resend
RESEND_FROM_EMAIL=calidad@griffo.com.ar
RESEND_FROM_NAME=Sistema de Calidad Griffo

# -----------------------------------------------------------
# App — Configuración general
# -----------------------------------------------------------

# URL pública de la app (para links en emails)
NEXT_PUBLIC_APP_URL=https://calidad.griffo.com.ar

# Nombre de la empresa (aparece en mails y reportes)
NEXT_PUBLIC_EMPRESA_NOMBRE=Griffo S.R.L.
